__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
results/evidence/*.png

# Ad hoc --url checks are scratch output, not part of the assessed federation run.
results/one-off/

# The official Tripartite list is committed, at checklist/approved-names.txt,
# and is the default. A list an operator drops next to it to override that one
# is their own input and is not: they are accountable for the list they ran
# with, and an unreviewed local edit must not reach the repository by accident.
# Anchored to the root so it cannot swallow the committed default.
/approved-names*.txt

# Backups written by basic-check --restore-default-config.
/nodes.yaml.*.bak
